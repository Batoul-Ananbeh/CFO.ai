AI_PROVIDER=google
AI_MODEL=gemini-3.6-flash
AI_TEMPERATURE=0
AI_TIMEOUT_MS=60000
AI_RETRY_ATTEMPTS=2
AI_MAX_OUTPUT_TOKENS=1024
AI_STRUCTURED_RESPONSE_ATTEMPTS=1
AI_THINKING_LEVEL=minimal

# Place the real key only inside .env.
GOOGLE_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://cfo_ai:cfo_ai_dev_password@localhost:5432/cfo_ai
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Docker PostgreSQL
POSTGRES_DB=cfo_ai
POSTGRES_USER=cfo_ai
POSTGRES_PASSWORD=cfo_ai_dev_password
POSTGRES_PORT=5432
